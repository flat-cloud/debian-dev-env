#!/usr/bin/env bash
# Keep reproducible project dependencies on ephemeral storage in Cloud Shell.

set -Eeuo pipefail

readonly STORE_ROOT="${NODETMP_STORE_DIR:-${TMPDIR:-/tmp}/dev_tmp_store/${UID}}"
readonly LEGACY_STORE_ROOT="${TMPDIR:-/tmp}/dev_tmp_store"
readonly SCAN_DEPTH="${NODETMP_SCAN_DEPTH:-8}"
DRY_RUN=false

show_help() {
    cat <<'EOF'
Usage: nodetmp [command] [options]

Commands:
  enforce [path]    Recursively offload dependencies, repair links, cache, and prune
  link [path]       Offload dependencies for one project
  install, i        Ensure /tmp symlinks exist, then run `npm install`
  venv              Ensure /tmp .venv exists, then create a virtualenv
  status, s         Check dependency status for the current project
  scan [path]       Audit dependency locations without changing them
  fix, repair       Re-create missing /tmp targets for managed broken symlinks
  clean             Remove managed symlinks and temp data for the current project
  prune [path]      Prune unused Docker data, dependencies, builds, and old binaries
  help              Display this help message

Supported project directories:
  node_modules      package.json
  vendor            composer.json
  .venv             pyproject.toml, requirements.txt, Pipfile, or uv.lock
  target            Cargo.toml
  .next             next.config.js, next.config.mjs, next.config.ts

Options for enforce:
  --dry-run         Show what would change
  --no-caches       Do not migrate known package-manager/browser caches

Options for prune:
  --dry-run         Show filesystem changes; Docker reports usage only
  --no-docker       Do not prune unused Docker images and build cache
  --no-deps         Do not offload dependencies or remove orphaned temp stores
  --no-binaries     Do not prune superseded Codex releases or NVM cache

Environment:
  NODETMP_STORE_DIR Override the temp storage root (default: /tmp/dev_tmp_store/$UID)
  NODETMP_SCAN_DEPTH Maximum recursive scan depth (default: 8)

Aliases:
  npmi      -> nodetmp install
  nmlink    -> nodetmp link
  nmenforce -> nodetmp enforce
  nmstatus  -> nodetmp status
  nmfix     -> nodetmp fix
  nmprune   -> nodetmp prune
  pyvenv    -> nodetmp venv
EOF
}

fail() {
    echo "nodetmp: $*" >&2
    return 1
}

canonical_directory() {
    local directory="$1"
    [[ -d "$directory" ]] || fail "directory does not exist: $directory"
    (cd -- "$directory" && pwd -P)
}

project_hash() {
    local project_path="$1"

    if command -v sha256sum >/dev/null 2>&1; then
        printf '%s' "$project_path" | sha256sum | cut -d' ' -f1 | cut -c1-12
    elif command -v shasum >/dev/null 2>&1; then
        printf '%s' "$project_path" | shasum -a 256 | cut -d' ' -f1 | cut -c1-12
    else
        printf '%s' "$project_path" | cksum | cut -d' ' -f1
    fi
}

get_project_tmp_store() {
    local project_path="$1"
    local project_name
    local hash

    project_name="$(basename -- "$project_path")"
    hash="$(project_hash "$project_path")"
    printf '%s/%s_%s\n' "$STORE_ROOT" "$project_name" "$hash"
}

ensure_project_store() {
    local store="$1"
    local project_path="${2:-}"

    mkdir -p -- "$store"
    chmod 700 -- "$STORE_ROOT" "$store" 2>/dev/null || true
    if [[ -n "$project_path" ]]; then
        printf '%s\n' "$project_path" >"$store/.nodetmp-project"
    fi
}

get_project_targets() {
    local project_path="$1"
    PROJECT_TARGETS=()

    if [[ -f "$project_path/package.json" || -e "$project_path/node_modules" || -L "$project_path/node_modules" ]]; then
        PROJECT_TARGETS+=(node_modules)
    fi
    if [[ -f "$project_path/composer.json" || -e "$project_path/vendor" || -L "$project_path/vendor" ]]; then
        PROJECT_TARGETS+=(vendor)
    fi
    if [[ -f "$project_path/pyproject.toml" || -f "$project_path/requirements.txt" || \
          -f "$project_path/Pipfile" || -f "$project_path/uv.lock" || \
          -e "$project_path/.venv" || -L "$project_path/.venv" ]]; then
        PROJECT_TARGETS+=(.venv)
    fi
    if [[ -f "$project_path/Cargo.toml" || -e "$project_path/target" || -L "$project_path/target" ]]; then
        PROJECT_TARGETS+=(target)
    fi
    if [[ -f "$project_path/next.config.js" || -f "$project_path/next.config.mjs" || \
          -f "$project_path/next.config.ts" || -e "$project_path/.next" || -L "$project_path/.next" ]]; then
        PROJECT_TARGETS+=(.next)
    fi
}

is_managed_target() {
    local target="$1"

    case "$target" in
        "$STORE_ROOT"/*|"$LEGACY_STORE_ROOT"/*) return 0 ;;
        *) return 1 ;;
    esac
}

# Older versions and project-specific helpers used these layouts before the
# per-user dev_tmp_store was introduced. They are safe to adopt because their
# contents are ephemeral dependencies, unlike arbitrary user-owned symlinks.
is_legacy_ephemeral_target() {
    local target="$1"
    local tmp_root="${TMPDIR:-/tmp}"

    case "$target" in
        "$tmp_root"/node_modules_store/*|"$tmp_root"/*-dependencies/*|"$tmp_root"/*_dependencies/*) return 0 ;;
        *) return 1 ;;
    esac
}

copy_then_remove() {
    local source="$1"
    local destination="$2"
    local staging="${destination}.incoming.$$"

    echo "📦 Moving $source to $destination..."

    # Copy first so a failed cross-filesystem transfer leaves the source intact.
    # Stage on the destination filesystem so stale temp contents cannot be merged.
    rm -rf -- "$staging"
    mkdir -p -- "$staging"
    if ! cp -a -- "$source/." "$staging/"; then
        rm -rf -- "$staging"
        fail "could not copy $source; the original directory was left untouched"
        return 1
    fi

    rm -rf -- "$destination"
    mv -- "$staging" "$destination"
    rm -rf -- "$source"
}

link_directory() {
    local source="$1"
    local destination="$2"
    local current_target

    if [[ -L "$source" ]]; then
        current_target="$(readlink -- "$source")"
        if [[ "$current_target" == "$destination" && -d "$destination" ]]; then
            echo "✅ Already linked: $source -> $destination"
            return 0
        fi
        if ! is_managed_target "$current_target"; then
            if ! is_legacy_ephemeral_target "$current_target"; then
                fail "refusing to replace unmanaged symlink: $source -> $current_target"
            fi
            if [[ -e "$current_target" && ! -d "$current_target" ]]; then
                fail "refusing to migrate non-directory legacy target: $current_target"
            fi
            if [[ "$DRY_RUN" == true ]]; then
                if [[ -d "$current_target" ]]; then
                    echo "[dry-run] Would migrate legacy link $source -> $destination"
                else
                    echo "[dry-run] Would replace broken legacy link $source -> $destination"
                fi
                return 0
            fi
            if [[ -d "$current_target" ]]; then
                echo "🔄 Migrating legacy ephemeral target: $current_target"
                copy_then_remove "$current_target" "$destination"
            else
                echo "🔧 Adopting broken legacy link: $source -> $destination"
            fi
        fi
        if [[ "$DRY_RUN" == true ]]; then
            echo "[dry-run] Would recreate $source -> $destination"
            return 0
        fi
        rm -f -- "$source"
    elif [[ -e "$source" ]]; then
        [[ -d "$source" ]] || fail "refusing to replace non-directory: $source"
        if [[ "$DRY_RUN" == true ]]; then
            echo "[dry-run] Would move $source to $destination and create a symlink"
            return 0
        fi
        copy_then_remove "$source" "$destination"
    fi

    if [[ "$DRY_RUN" == true ]]; then
        echo "[dry-run] Would link $source -> $destination"
        return 0
    fi

    mkdir -p -- "$(dirname -- "$destination")" "$destination" "$(dirname -- "$source")"
    ln -s -- "$destination" "$source"
    echo "✅ Linked: $source -> $destination"
}

link_target() {
    local project_path="$1"
    local target_name="$2"
    local store="$3"

    link_directory "$project_path/$target_name" "$store/$target_name"
}

do_link() {
    local requested_path="${1:-$PWD}"
    local project_path
    local project_name
    local store
    local target_name

    project_path="$(canonical_directory "$requested_path")"
    if [[ ! -w "$project_path" ]]; then
        echo "⚠️  Skipping non-writable project directory: $project_path"
        return 0
    fi
    project_name="$(basename -- "$project_path")"
    store="$(get_project_tmp_store "$project_path")"
    get_project_targets "$project_path"

    if [[ "${#PROJECT_TARGETS[@]}" -eq 0 ]]; then
        echo "ℹ️  No supported dependency directories detected in $project_path."
        return 0
    fi

    echo "🔗 Offloading project targets for $project_name to ephemeral storage..."
    if [[ "$DRY_RUN" == false ]]; then
        ensure_project_store "$store" "$project_path"
    fi

    for target_name in "${PROJECT_TARGETS[@]}"; do
        link_target "$project_path" "$target_name" "$store"
    done
}

do_caches() {
    local source
    local cache_name
    local -a cache_specs=(
        "$HOME/.npm|npm"
        "$HOME/.cache/pip|pip"
        "$HOME/.cache/uv|uv"
        "$HOME/.cache/yarn|yarn"
        "$HOME/.cache/pnpm|pnpm"
        "$HOME/.local/share/pnpm/store|pnpm-store"
        "$HOME/.cache/ms-playwright|ms-playwright"
        "$HOME/.cache/puppeteer|puppeteer"
        "$HOME/.cache/Cypress|cypress"
        "$HOME/.cache/composer|composer"
        "$HOME/.composer/cache|composer-home"
        "$HOME/.cache/cloud-code|cloud-code"
        "$HOME/.cache/go-build|go-build"
        "$HOME/gopath/pkg|gopath-pkg"
    )

    echo "🗃️  Offloading existing package and browser caches..."
    for spec in "${cache_specs[@]}"; do
        source="${spec%%|*}"
        cache_name="${spec##*|}"
        link_directory "$source" "$STORE_ROOT/cache/$cache_name"
    done
}

do_enforce() {
    local requested_path="$HOME"
    local include_caches=true
    local search_path
    local manifest
    local project_path
    local count=0
    local argument
    declare -A seen_projects=()

    for argument in "$@"; do
        case "$argument" in
            --dry-run) DRY_RUN=true ;;
            --no-caches) include_caches=false ;;
            -*) fail "unknown enforce option: $argument"; return 1 ;;
            *) requested_path="$argument" ;;
        esac
    done

    search_path="$(canonical_directory "$requested_path")"
    echo "🛡️  Enforcing ephemeral dependencies under $search_path..."

    while IFS= read -r -d '' manifest; do
        project_path="$(dirname -- "$manifest")"
        if [[ -n "${seen_projects[$project_path]+present}" ]]; then
            continue
        fi
        seen_projects["$project_path"]=1
        do_link "$project_path"
        count=$((count + 1))
    done < <(
        find "$search_path" -xdev -mindepth 1 -maxdepth "$SCAN_DEPTH" \
            \( -type d \( -name '.*' -o -name node_modules -o -name vendor -o \
                -name .venv -o -name target -o -name gopath \) -prune \) -o \
            \( -type f \( -name package.json -o -name composer.json -o -name pyproject.toml -o \
                -name requirements.txt -o -name Pipfile -o -name uv.lock -o -name Cargo.toml -o \
                -name next.config.js -o -name next.config.mjs -o -name next.config.ts \) \
                -print0 \) -o \
            \( -type l \( -name node_modules -o -name vendor -o -name .venv -o \
                -name target -o -name .next \) -print0 \) 2>/dev/null
    )

    if [[ "$include_caches" == true && "$search_path" == "$HOME" ]]; then
        do_caches
        # Enforcement already handled dependencies. Keep automatic boot/install
        # enforcement from unexpectedly pruning the machine-wide Docker daemon.
        do_prune "$HOME" --no-docker --no-deps
    fi

    if [[ "$DRY_RUN" == true ]]; then
        echo "✅ Dry run complete; inspected $count project(s)."
    else
        echo "✅ Enforcement complete; inspected $count project(s)."
    fi
}

do_install() {
    do_link "$PWD"
    if [[ -f package.json ]]; then
        echo "📥 Running npm install..."
        npm install "$@"
    else
        fail "package.json not found in $PWD"
    fi
}

do_venv() {
    local store

    do_link "$PWD"
    [[ -f requirements.txt || -f pyproject.toml || -e .venv || -L .venv ]] || \
        fail "Python project not detected in $PWD"

    store="$(get_project_tmp_store "$(pwd -P)")"
    if [[ ! -f "$store/.venv/bin/activate" ]]; then
        echo "🐍 Creating Python virtualenv in $store/.venv..."
        python3 -m venv "$store/.venv"
    fi
    echo "✅ Python .venv ready at $PWD/.venv"
    echo "👉 Activate with: source .venv/bin/activate"
}

print_target_status() {
    local target_name="$1"
    local target_path="$PWD/$target_name"
    local link_destination
    local size

    if [[ -L "$target_path" ]]; then
        link_destination="$(readlink -- "$target_path")"
        if [[ -d "$link_destination" ]]; then
            size="$(du -sh -- "$link_destination" 2>/dev/null | cut -f1)"
            echo "  [$target_name] Symlinked -> $link_destination ($size in temp storage)"
        else
            echo "  [$target_name] ⚠️ BROKEN symlink -> $link_destination"
        fi
    elif [[ -d "$target_path" ]]; then
        size="$(du -sh -- "$target_path" 2>/dev/null | cut -f1)"
        echo "  [$target_name] REAL directory ($size on persistent storage)"
    else
        echo "  [$target_name] Not present"
    fi
}

do_status() {
    local target_name

    echo "📊 Status for $PWD:"
    get_project_targets "$PWD"
    if [[ "${#PROJECT_TARGETS[@]}" -eq 0 ]]; then
        echo "  No supported dependency directories detected."
        return 0
    fi
    for target_name in "${PROJECT_TARGETS[@]}"; do
        print_target_status "$target_name"
    done
}

restore_managed_link() {
    local link_path="$1"
    local old_target="$2"
    local project_path
    local target_name
    local store
    local new_target

    project_path="$(dirname -- "$link_path")"
    target_name="$(basename -- "$link_path")"
    store="$(get_project_tmp_store "$(canonical_directory "$project_path")")"
    new_target="$store/$target_name"

    if ! is_managed_target "$old_target"; then
        echo "⚠️  Skipping unmanaged broken symlink: $link_path -> $old_target" >&2
        return 2
    fi

    ensure_project_store "$store" "$project_path"
    mkdir -p -- "$new_target"
    rm -f -- "$link_path"
    ln -s -- "$new_target" "$link_path"
    echo "🔧 Restored: $link_path -> $new_target"

    if [[ "$target_name" == node_modules && -f "$project_path/package.json" ]]; then
        echo "📥 Running npm install in $project_path..."
        (cd -- "$project_path" && npm install)
    elif [[ "$target_name" == vendor && -f "$project_path/composer.json" ]]; then
        echo "📥 Running composer install in $project_path..."
        (cd -- "$project_path" && composer install --no-interaction)
    elif [[ "$target_name" == .venv && ( -f "$project_path/requirements.txt" || -f "$project_path/pyproject.toml" ) ]]; then
        echo "🐍 Re-creating Python venv in $project_path..."
        python3 -m venv "$new_target"
        if [[ -f "$project_path/requirements.txt" ]]; then
            "$new_target/bin/pip" install -r "$project_path/requirements.txt"
        fi
    fi
}

do_fix() {
    local requested_path="${1:-$HOME}"
    local search_path
    local count=0
    local skipped=0
    local failed=0
    local link_path
    local target

    search_path="$(canonical_directory "$requested_path")"
    echo "🛠️  Scanning for broken managed symlinks in $search_path..."

    while IFS= read -r -d '' link_path; do
        [[ ! -e "$link_path" ]] || continue
        target="$(readlink -- "$link_path")"
        if restore_managed_link "$link_path" "$target"; then
            count=$((count + 1))
        else
            case $? in
                2) skipped=$((skipped + 1)) ;;
                *) failed=$((failed + 1)) ;;
            esac
        fi
    done < <(find "$search_path" -mindepth 1 -maxdepth "$SCAN_DEPTH" \
        \( -type d \( -name '.*' -o -name gopath \) -prune \) -o \
        \( -name node_modules -o -name vendor -o -name .venv -o -name target -o -name .next \) \
        -type l -print0 2>/dev/null)

    echo "✅ Restored $count target(s); skipped $skipped unmanaged link(s)."
    [[ "$failed" -eq 0 ]] || fail "$failed target(s) could not be restored"
}

do_scan() {
    local requested_path="${1:-$HOME}"
    local search_path
    local target_path
    local target
    local size

    search_path="$(canonical_directory "$requested_path")"
    echo "🔍 Scanning $search_path for offloaded targets..."
    echo "--------------------------------------------------------------------------------"

    while IFS= read -r -d '' target_path; do
        if [[ -L "$target_path" ]]; then
            target="$(readlink -- "$target_path")"
            if [[ -d "$target" ]]; then
                size="$(du -sh -- "$target" 2>/dev/null | cut -f1)"
                echo " [SYMLINK] $target_path -> $target ($size in temp storage)"
            else
                echo " [BROKEN]  $target_path -> $target (missing)"
            fi
        else
            size="$(du -sh -- "$target_path" 2>/dev/null | cut -f1)"
            echo " [REAL]     $target_path ($size on persistent storage)"
        fi
    done < <(
        find "$search_path" -xdev -mindepth 1 -maxdepth "$SCAN_DEPTH" \
            \( -type d \( -name '.*' ! -name .venv -o -name gopath \) -prune \) -o \
            \( -type d \( -name node_modules -o -name vendor -o -name .venv -o -name target -o -name .next \) \
                -print0 -prune \) -o \
            \( -type l \( -name node_modules -o -name vendor -o -name .venv -o -name target -o -name .next \) \
                -print0 \) 2>/dev/null
    )

    echo "--------------------------------------------------------------------------------"
}

do_clean() {
    local project_path
    local store
    local target_name
    local link_path
    local link_destination

    project_path="$(pwd -P)"
    store="$(get_project_tmp_store "$project_path")"
    get_project_targets "$project_path"

    for target_name in "${PROJECT_TARGETS[@]}"; do
        link_path="$project_path/$target_name"
        if [[ -L "$link_path" ]]; then
            link_destination="$(readlink -- "$link_path")"
            if is_managed_target "$link_destination"; then
                rm -f -- "$link_path"
                echo "🧹 Removed managed $target_name symlink"
            else
                echo "⚠️  Left unmanaged symlink untouched: $link_path -> $link_destination" >&2
            fi
        fi
    done

    if [[ -d "$store" ]]; then
        rm -rf -- "$store"
        echo "🧹 Removed temp store: $store"
    fi
}

project_supports_target() {
    local project_path="$1"
    local target_name="$2"

    case "$target_name" in
        node_modules) [[ -f "$project_path/package.json" ]] ;;
        vendor) [[ -f "$project_path/composer.json" ]] ;;
        .venv) [[ -f "$project_path/pyproject.toml" || -f "$project_path/requirements.txt" || \
            -f "$project_path/Pipfile" || -f "$project_path/uv.lock" ]] ;;
        target) [[ -f "$project_path/Cargo.toml" ]] ;;
        .next) [[ -f "$project_path/next.config.js" || -f "$project_path/next.config.mjs" || \
            -f "$project_path/next.config.ts" ]] ;;
        *) return 1 ;;
    esac
}

prune_dependencies() {
    local search_root="$1"
    local target_path
    local target_name
    local project_path
    local store
    local link_path
    local link_target
    local relative_target
    local store_name
    local manifest
    declare -A referenced_stores=()
    PRUNE_STEP_COUNT=0

    echo "📦 Offloading persistent dependency directories..."
    while IFS= read -r -d '' target_path; do
        project_path="$(dirname -- "$target_path")"
        target_name="$(basename -- "$target_path")"
        project_supports_target "$project_path" "$target_name" || continue
        if [[ ! -w "$project_path" ]]; then
            echo "⚠️  Skipping non-writable dependency: $target_path"
            continue
        fi
        store="$(get_project_tmp_store "$(canonical_directory "$project_path")")"
        if [[ "$DRY_RUN" == false ]]; then
            ensure_project_store "$store" "$project_path"
        fi
        link_target "$project_path" "$target_name" "$store"
        PRUNE_STEP_COUNT=$((PRUNE_STEP_COUNT + 1))
    done < <(
        find "$search_root" -xdev -mindepth 1 -maxdepth "$SCAN_DEPTH" \
            \( -type d \( -name node_modules -o -name vendor -o -name .venv -o \
                -name target -o -name .next \) -print0 -prune \) -o \
            \( -type d \( -name '.*' -o -name gopath \) -prune \) 2>/dev/null
    )

    # Mark stores referenced by managed project links.
    while IFS= read -r -d '' link_path; do
        link_target="$(readlink -- "$link_path")"
        case "$link_target" in
            "$STORE_ROOT"/*/*)
                relative_target="${link_target#"$STORE_ROOT"/}"
                store_name="${relative_target%%/*}"
                referenced_stores["$STORE_ROOT/$store_name"]=1
                if [[ "$DRY_RUN" == false && -d "$STORE_ROOT/$store_name" ]]; then
                    printf '%s\n' "$(dirname -- "$link_path")" \
                        >"$STORE_ROOT/$store_name/.nodetmp-project"
                fi
                ;;
        esac
    done < <(
        find "$search_root" -xdev -mindepth 1 -maxdepth "$SCAN_DEPTH" \
            \( -type d \( -name .git -o -name node_modules -o -name vendor -o \
                -name .venv -o -name target -o -name .next \) -prune \) -o \
            \( -type l \( -name node_modules -o -name vendor -o -name .venv -o \
                -name target -o -name .next \) -print0 \) 2>/dev/null
    )

    # Also protect the deterministic store for every existing project. This
    # keeps dry-run output accurate before a real dependency has been offloaded.
    while IFS= read -r -d '' manifest; do
        project_path="$(dirname -- "$manifest")"
        store="$(get_project_tmp_store "$(canonical_directory "$project_path")")"
        referenced_stores["$store"]=1
    done < <(
        find "$search_root" -xdev -mindepth 1 -maxdepth "$SCAN_DEPTH" \
            \( -type d \( -name '.*' -o -name node_modules -o -name vendor -o \
                -name .venv -o -name target -o -name gopath \) -prune \) -o \
            \( -type f \( -name package.json -o -name composer.json -o -name pyproject.toml -o \
                -name requirements.txt -o -name Pipfile -o -name uv.lock -o -name Cargo.toml -o \
                -name next.config.js -o -name next.config.mjs -o -name next.config.ts \) \
                -print0 \) 2>/dev/null
    )

    # The store is per-user but can serve several projects. Only a home-wide
    # prune has enough visibility to safely classify an immediate child orphan.
    if [[ "$search_root" == "$HOME" && -d "$STORE_ROOT" ]]; then
        echo "🧹 Removing unreferenced temporary dependency stores..."
        while IFS= read -r -d '' store; do
            local marker="$store/.nodetmp-project"
            local recorded_project
            local recorded_target
            [[ "$(basename -- "$store")" == cache ]] && continue
            [[ -n "${referenced_stores[$store]+present}" ]] && continue
            # Untagged stores may belong to projects outside the search root
            # and predate ownership markers. Preserve them conservatively.
            [[ -f "$marker" ]] || continue
            IFS= read -r recorded_project <"$marker" || recorded_project=""
            if [[ -d "$recorded_project" ]]; then
                for target_name in node_modules vendor .venv target .next; do
                    link_path="$recorded_project/$target_name"
                    [[ -L "$link_path" ]] || continue
                    recorded_target="$(readlink -- "$link_path")"
                    if [[ "$recorded_target" == "$store"/* ]]; then
                        referenced_stores["$store"]=1
                        break
                    fi
                done
            fi
            [[ -n "${referenced_stores[$store]+present}" ]] && continue
            if [[ "$DRY_RUN" == true ]]; then
                echo "[dry-run] Would remove orphaned dependency store: $store"
            else
                rm -rf -- "$store"
                echo "🧹 Removed orphaned dependency store: $store"
            fi
            PRUNE_STEP_COUNT=$((PRUNE_STEP_COUNT + 1))
        done < <(find "$STORE_ROOT" -mindepth 1 -maxdepth 1 -type d -print0 2>/dev/null)
    fi
}

prune_versioned_binaries() {
    local search_root="$1"
    local packages_root="$search_root/.codex/packages"
    local package_dir
    local releases_dir
    local current_target
    local release
    local nvm_cache="$search_root/.nvm/.cache"
    PRUNE_STEP_COUNT=0

    # Every Codex package channel has its own releases/ and current symlink.
    # Discover them rather than special-casing only the standalone CLI.
    if [[ -d "$packages_root" ]]; then
        while IFS= read -r -d '' package_dir; do
            releases_dir="$package_dir/releases"
            [[ -d "$releases_dir" ]] || continue
            current_target="$(readlink -f -- "$package_dir/current" 2>/dev/null || true)"
            if [[ -z "$current_target" || ! -d "$current_target" || \
                  "$current_target" != "$releases_dir"/* ]]; then
                echo "⚠️  Skipping versioned package with no valid current release: $package_dir"
                continue
            fi
            while IFS= read -r -d '' release; do
                [[ "$release" == "$current_target" ]] && continue
                if [[ "$DRY_RUN" == true ]]; then
                    echo "[dry-run] Would remove superseded $(basename -- "$package_dir") release: $release"
                else
                    rm -rf -- "$release"
                    echo "🧹 Removed superseded $(basename -- "$package_dir") release: $(basename -- "$release")"
                fi
                PRUNE_STEP_COUNT=$((PRUNE_STEP_COUNT + 1))
            done < <(find "$releases_dir" -mindepth 1 -maxdepth 1 -type d -print0 2>/dev/null)
        done < <(find "$packages_root" -mindepth 1 -maxdepth 1 -type d -print0 2>/dev/null)
    fi

    # NVM keeps downloaded archives after installation. Installed Node versions
    # remain untouched; only the reproducible download cache is removed.
    if [[ -d "$nvm_cache" ]]; then
        if [[ "$DRY_RUN" == true ]]; then
            echo "[dry-run] Would remove NVM download cache: $nvm_cache"
        else
            rm -rf -- "$nvm_cache"
            echo "🧹 Removed NVM download cache: $nvm_cache"
        fi
        PRUNE_STEP_COUNT=$((PRUNE_STEP_COUNT + 1))
    fi
}

prune_docker() {
    local -a docker_command=(docker)
    PRUNE_STEP_COUNT=0

    command -v docker >/dev/null 2>&1 || return 0
    if ! docker info >/dev/null 2>&1; then
        if command -v sudo >/dev/null 2>&1 && sudo -n docker info >/dev/null 2>&1; then
            docker_command=(sudo -n docker)
        else
            echo "⚠️  Skipping Docker prune; the daemon is not accessible."
            return 0
        fi
    fi

    if [[ "$DRY_RUN" == true ]]; then
        echo "[dry-run] Would prune all Docker images unused by containers and all build cache."
        "${docker_command[@]}" system df 2>/dev/null || true
        return 0
    fi

    echo "🐳 Pruning Docker images unused by containers..."
    if "${docker_command[@]}" image prune --all --force; then
        PRUNE_STEP_COUNT=$((PRUNE_STEP_COUNT + 1))
    else
        echo "⚠️  Docker image prune failed; continuing with local cleanup." >&2
    fi
    echo "🐳 Pruning Docker build cache..."
    if "${docker_command[@]}" builder prune --all --force; then
        PRUNE_STEP_COUNT=$((PRUNE_STEP_COUNT + 1))
    else
        echo "⚠️  Docker builder prune failed; continuing with local cleanup." >&2
    fi
}

# Prune items that grow unboundedly on persistent $HOME storage but are safe to
# delete or offload: unused Docker data, project dependencies, superseded binary
# releases, editor logs, stale shell caches, leaked stores, and ignored builds.
do_prune() {
    local search_root="$HOME"
    local include_docker=true
    local include_dependencies=true
    local include_binaries=true
    local freed=0
    local path
    local argument

    for argument in "$@"; do
        case "$argument" in
            --dry-run) DRY_RUN=true ;;
            --no-docker) include_docker=false ;;
            --no-deps) include_dependencies=false ;;
            --no-binaries) include_binaries=false ;;
            -*) fail "unknown prune option: $argument"; return 1 ;;
            *) search_root="$argument" ;;
        esac
    done

    search_root="$(canonical_directory "$search_root")"

    echo "✂️  Pruning stale data under $search_root..."

    # 1. Superseded versioned binaries and reproducible runtime archives.
    if [[ "$include_binaries" == true ]]; then
        prune_versioned_binaries "$search_root"
        freed=$((freed + PRUNE_STEP_COUNT))
    fi

    # 2. Persistent dependencies are offloaded; unreferenced temp stores are
    # removed only when the entire home tree is in scope.
    if [[ "$include_dependencies" == true ]]; then
        prune_dependencies "$search_root"
        freed=$((freed + PRUNE_STEP_COUNT))
    fi

    # 3. Docker is machine-wide, so run it only for the default home-wide prune.
    if [[ "$include_docker" == true && "$search_root" == "$HOME" ]]; then
        prune_docker
        freed=$((freed + PRUNE_STEP_COUNT))
    fi

    # 4. CodeOSS / VS Code IDE log directory (regenerated each session).
    local editor_logs="$search_root/.codeoss/data/logs"
    if [[ -d "$editor_logs" ]]; then
        if [[ "$DRY_RUN" == true ]]; then
            echo "[dry-run] Would clear editor logs: $editor_logs"
        else
            rm -rf -- "$editor_logs/"*
            echo "🧹 Cleared editor logs: $editor_logs"
            freed=$((freed + 1))
        fi
    fi

    # 5. Stale zcompdump files from previous Cloud Shell hostnames.
    #    Pattern: ~/.zcompdump-<hostname>-* (hostname differs from current host).
    local current_host
    current_host="$(hostname 2>/dev/null || true)"
    while IFS= read -r -d '' path; do
        local fname
        fname="$(basename -- "$path")"
        # Skip the current host's file.
        [[ "$fname" == ".zcompdump-${current_host}-"* ]] && continue
        if [[ "$DRY_RUN" == true ]]; then
            echo "[dry-run] Would remove stale zcompdump: $path"
        else
            rm -f -- "$path"
            echo "🧹 Removed stale zcompdump: $fname"
            freed=$((freed + 1))
        fi
    done < <(find "$search_root" -maxdepth 1 -name '.zcompdump-*' -print0 2>/dev/null)

    # 6. dev_tmp_store leaked onto persistent $HOME (should live in /tmp).
    #    Only remove if it is NOT the configured STORE_ROOT.
    local leaked_store="$search_root/tmp/dev_tmp_store"
    if [[ -d "$leaked_store" && "$leaked_store" != "$STORE_ROOT" ]]; then
        if [[ "$DRY_RUN" == true ]]; then
            echo "[dry-run] Would remove leaked persistent tmp store: $leaked_store"
        else
            rm -rf -- "$leaked_store"
            # Remove parent ~/tmp if now empty.
            rmdir -- "$(dirname -- "$leaked_store")" 2>/dev/null || true
            echo "🧹 Removed leaked persistent tmp store: $leaked_store"
            freed=$((freed + 1))
        fi
    fi

    # 7. Reproducible dist output, but only when the owning Git repository says
    #    it is ignored. This avoids deleting tracked release artifacts or an
    #    unrelated directory that merely happens to be named dist.
    local repo_root
    local relative_path
    while IFS= read -r -d '' path; do
        repo_root="$(git -C "$path" rev-parse --show-toplevel 2>/dev/null || true)"
        [[ -n "$repo_root" && "$path" == "$repo_root"/* ]] || continue
        relative_path="${path#"$repo_root"/}"
        if ! git -C "$repo_root" check-ignore -q -- "$relative_path"; then
            continue
        fi
        if [[ "$DRY_RUN" == true ]]; then
            echo "[dry-run] Would remove ignored dist build output: $path"
        else
            rm -rf -- "$path"
            echo "🧹 Removed ignored dist build output: $path"
            freed=$((freed + 1))
        fi
    done < <(
        if command -v git >/dev/null 2>&1; then
            find "$search_root" -xdev -mindepth 1 -maxdepth "$SCAN_DEPTH" \
                \( -type d \( -name '.*' -o -name node_modules -o -name vendor -o \
                    -name .venv -o -name target -o -name gopath \) -prune \) -o \
                \( -type d -name dist -print0 -prune \) 2>/dev/null
        fi
    )

    if [[ "$DRY_RUN" == true ]]; then
        echo "✅ Dry-run prune complete."
    else
        echo "✅ Prune complete; $freed item(s) removed."
    fi
}

main() {
    local command="${1:-link}"
    if [[ $# -gt 0 ]]; then
        shift
    fi

    case "$command" in
        enforce)    do_enforce "$@" ;;
        link)       do_link "$@" ;;
        install|i)  do_install "$@" ;;
        venv)       do_venv "$@" ;;
        status|s)   do_status ;;
        scan)       do_scan "$@" ;;
        fix|repair) do_fix "$@" ;;
        clean)      do_clean ;;
        prune)      do_prune "$@" ;;
        help|--help|-h) show_help ;;
        *)
            echo "Unknown command: $command" >&2
            show_help >&2
            return 1
            ;;
    esac
}

main "$@"
