#!/usr/bin/env bash
# ==============================================================================
# nodetmp / tmpstore - Offload node_modules & Python .venv to /tmp to save $HOME
# ==============================================================================

set -e

show_help() {
    cat << EOF
Usage: nodetmp [command] [options]

Commands:
  link (default)    Symlink node_modules and .venv in current directory to /tmp
  install, i        Ensure /tmp symlinks exist, then run `npm install`
  venv              Ensure /tmp .venv exists, then create/activate virtualenv
  status, s         Check node_modules & .venv status & disk usage for current project
  scan [path]       Scan directory for offloaded node_modules & .venv folders
  fix, repair       Re-create missing /tmp targets for broken symlinks
  clean             Remove /tmp store and symlinks for current project
  help              Display this help message

Aliases:
  npmi     -> nodetmp install
  nmlink   -> nodetmp link
  nmstatus -> nodetmp status
  pyvenv   -> nodetmp venv
EOF
}

CMD="${1:-link}"
if [ $# -gt 0 ]; then
    shift
fi

get_project_tmp_store() {
    local proj_path="$1"
    local proj_name
    proj_name="$(basename "$proj_path")"
    local proj_hash
    proj_hash="$(echo -n "$proj_path" | md5sum | cut -d" " -f1 | cut -c1-8)"
    echo "/tmp/dev_tmp_store/${proj_name}_${proj_hash}"
}

do_link() {
    local target_dir="${1:-$PWD}"
    cd "$target_dir"

    local proj_name
    proj_name="$(basename "$PWD")"
    local tmp_store
    tmp_store="$(get_project_tmp_store "$PWD")"

    echo "🔗 Offloading project targets for  to /tmp..."
    mkdir -p "$tmp_store/node_modules" "$tmp_store/.venv"

    # Node.js node_modules
    if [ -f "package.json" ] || [ -d "node_modules" ]; then
        if [ -d "node_modules" ] && [ ! -L "node_modules" ]; then
            echo "📦 Moving existing node_modules to $tmp_store/node_modules..."
            cp -r node_modules/* "$tmp_store/node_modules/" 2>/dev/null || true
            rm -rf node_modules
        fi
        if [ -L "node_modules" ]; then
            rm -f node_modules
        fi
        ln -s "$tmp_store/node_modules" node_modules
        echo "✅ Linked: $PWD/node_modules -> $tmp_store/node_modules"
    fi

    # Python .venv
    if [ -f "requirements.txt" ] || [ -f "pyproject.toml" ] || [ -d ".venv" ]; then
        if [ -d ".venv" ] && [ ! -L ".venv" ]; then
            echo "🐍 Moving existing .venv to $tmp_store/.venv..."
            cp -r .venv/* "$tmp_store/.venv/" 2>/dev/null || true
            rm -rf .venv
        fi
        if [ -L ".venv" ]; then
            rm -f .venv
        fi
        ln -s "$tmp_store/.venv" .venv
        echo "✅ Linked: $PWD/.venv -> $tmp_store/.venv"
    fi
}

do_install() {
    do_link "$PWD"
    if [ -f "package.json" ]; then
        echo "📥 Running npm install..."
        npm install "$@"
    fi
}

do_venv() {
    do_link "$PWD"
    local tmp_store
    tmp_store="$(get_project_tmp_store "$PWD")"
    if [ ! -f "$tmp_store/.venv/bin/activate" ]; then
        echo "🐍 Creating Python virtualenv in $tmp_store/.venv..."
        python3 -m venv "$tmp_store/.venv"
    fi
    echo "✅ Python .venv ready at $PWD/.venv"
    echo "👉 Activate with: source .venv/bin/activate"
}

do_status() {
    echo "📊 Status for jkru23ger:"
    local tmp_store
    tmp_store="$(get_project_tmp_store "$PWD")"

    # node_modules check
    if [ -L "node_modules" ]; then
        local link_target
        link_target="$(readlink "node_modules")"
        if [ -d "$link_target" ]; then
            local size
            size="$(du -sh "$link_target" 2>/dev/null | cut -f1)"
            echo "  [node_modules] Symlinked -> $link_target ($size in /tmp)"
        else
            echo "  [node_modules] ⚠️ BROKEN symlink -> $link_target"
        fi
    elif [ -d "node_modules" ]; then
        local size
        size="$(du -sh node_modules 2>/dev/null | cut -f1)"
        echo "  [node_modules] REAL directory ($size on $HOME)"
    fi

    # .venv check
    if [ -L ".venv" ]; then
        local link_target
        link_target="$(readlink ".venv")"
        if [ -d "$link_target" ]; then
            local size
            size="$(du -sh "$link_target" 2>/dev/null | cut -f1)"
            echo "  [.venv]        Symlinked -> $link_target ($size in /tmp)"
        else
            echo "  [.venv]        ⚠️ BROKEN symlink -> $link_target"
        fi
    elif [ -d ".venv" ]; then
        local size
        size="$(du -sh .venv 2>/dev/null | cut -f1)"
        echo "  [.venv]        REAL directory ($size on $HOME)"
    fi
}

do_fix() {
    echo "🛠️  Scanning for broken /tmp symlinks in $HOME..."
    local search_dir="${1:-$HOME}"
    local count=0

    while IFS= read -r link_path; do
        if [ -L "$link_path" ] && [ ! -e "$link_path" ]; then
            local target
            target="$(readlink "$link_path")"
            local proj_dir
            proj_dir="$(dirname "$link_path")"
            echo "🔧 Restoring target dir for broken link: $link_path -> $target"
            mkdir -p "$target"
            
            if [ "$(basename "$link_path")" = "node_modules" ] && [ -f "$proj_dir/package.json" ]; then
                echo "📥 Running npm install in $proj_dir..."
                (cd "$proj_dir" && npm install || true)
            elif [ "$(basename "$link_path")" = ".venv" ] && [ -f "$proj_dir/requirements.txt" ]; then
                echo "🐍 Re-creating Python venv in $proj_dir..."
                python3 -m venv "$target"
                (cd "$proj_dir" && "$target/bin/pip" install -r requirements.txt || true)
            fi
            count=$((count + 1))
        fi
    done < <(find "$search_dir" -maxdepth 5 \( -name "node_modules" -o -name ".venv" \) -type l 2>/dev/null || true)

    if [ "$count" -eq 0 ]; then
        echo "✅ No broken symlinks found."
    else
        echo "🎉 Restored $count project targets in /tmp!"
    fi
}

do_scan() {
    local search_dir="${1:-$HOME}"
    echo "🔍 Scanning  for offloaded targets..."
    echo "--------------------------------------------------------------------------------"
    find "$search_dir" -maxdepth 5 \( -name "node_modules" -o -name ".venv" \) 2>/dev/null | while read -r target_path; do
        if [ -L "$target_path" ]; then
            local target
            target="$(readlink "$target_path")"
            if [ -d "$target" ]; then
                local sz
                sz="$(du -sh "$target" 2>/dev/null | cut -f1)"
                echo " [SYMLINK] $target_path -> $target ($sz in /tmp)"
            else
                echo " [BROKEN]  $target_path -> $target (Missing)"
            fi
        else
            local sz
            sz="$(du -sh "$target_path" 2>/dev/null | cut -f1)"
            echo " [REAL]     $target_path ($sz on $HOME)"
        fi
    done
    echo "--------------------------------------------------------------------------------"
}

do_clean() {
    local tmp_store
    tmp_store="$(get_project_tmp_store "$PWD")"
    if [ -d "$tmp_store" ]; then
        rm -rf "$tmp_store"
        echo "🧹 Removed /tmp store: $tmp_store"
    fi
    for target in node_modules .venv; do
        if [ -L "$target" ]; then
            rm -f "$target"
            echo "🧹 Removed $target symlink"
        fi
    done
}

case "$CMD" in
    link)       do_link "$@" ;;
    install|i)  do_install "$@" ;;
    venv)       do_venv "$@" ;;
    status|s)   do_status "$@" ;;
    scan)       do_scan "$@" ;;
    fix|repair) do_fix "$@" ;;
    clean)      do_clean "$@" ;;
    help|--help|-h) show_help ;;
    *)
        echo "Unknown command: $CMD"
        show_help
        exit 1
        ;;
esac
